# Deployment environment example for release/v1-production

# Neon Postgres connection
DATABASE_URL=postgres://user:pass@host:port/dbname?sslmode=require

# Runtime
NODE_ENV=production

# For the Vite frontend (must start with VITE_ to be exposed)
VITE_API_URL=https://your-api.example.com

# Clerk is intentionally left pending — placeholders kept commented
# CLERK_PUBLISHABLE_KEY=
# CLERK_SECRET_KEY=
