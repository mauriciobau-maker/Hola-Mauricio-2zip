# Server & Application Configuration (Render / Production)
PORT=3000
NODE_ENV=production
CORS_ORIGIN=https://tu-app.vercel.app

# Neon Database (PostgreSQL Serverless)
# Formato: postgresql://<user>:<password>@<endpoint>-pooler.<region>.aws.neon.tech/<dbname>?sslmode=require
DATABASE_URL=

# Clerk Authentication (Opcional si usas Clerk para gestión de identidades)
# Frontend (Vercel)
VITE_CLERK_PUBLISHABLE_KEY=pk_test_...
# Backend (Render)
CLERK_SECRET_KEY=sk_test_...

# Legacy Replit OIDC (Solo requerido si ejecutas en entorno Replit)
ISSUER_URL=https://replit.com/oidc
REPL_ID=
