# ============================================================
# Padel Tracker IA - Environment Configuration
# ============================================================

# 1. Server Configuration
PORT=3000
NODE_ENV=development

# 2. Database (Neon PostgreSQL)
# Obtenida de tu dashboard en https://console.neon.tech
DATABASE_URL=postgresql://neondb_owner:YOUR_PASSWORD@ep-YOUR-PROJECT.us-east-2.aws.neon.tech/neondb?sslmode=require

# 3. Google Gemini API (Parryn - Secretario Deportivo IA)
# Obtenida de https://aistudio.google.com/app/apikey
GEMINI_API_KEY=AIzaSy...

# 4. Clerk Authentication (https://dashboard.clerk.com)
# Frontend (Vercel):
VITE_CLERK_PUBLISHABLE_KEY=pk_test_...
# Backend (Render):
CLERK_SECRET_KEY=sk_test_...

# 5. Production URLs (Render & Vercel)
# Frontend URL para CORS en el backend de Render:
FRONTEND_URL=https://padel-tracker.vercel.app
# Backend API URL para el cliente Vite en Vercel:
VITE_API_URL=https://padel-tracker-api.onrender.com
