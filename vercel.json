{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "node build-vercel.js",
  "outputDirectory": "public",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://parryn-api.onrender.com/api/:path*"
    },
    {
      "source": "/:path*",
      "destination": "/index.html"
    }
  ]
}
