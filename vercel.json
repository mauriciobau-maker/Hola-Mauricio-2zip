{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "npm install",
  "buildCommand": "npm run build --workspace=@workspace/padel-tracker",
  "outputDirectory": "artifacts/padel-tracker/dist/public",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "https://padel-tracker-api.onrender.com/api/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
