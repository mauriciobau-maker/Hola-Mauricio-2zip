{
  "buildCommand": "npm run build --workspace=@workspace/padel-tracker",
  "outputDirectory": "artifacts/padel-tracker/dist/public",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
